{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "shell:allow-open",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "python3",
          "args": true,
          "sidecar": false
        },
        {
          "name": "xdg-open",
          "args": true
        },
        {
          "name": "explorer",
          "args": true
        },
        {
          "name": "open",
          "args": true
        }
      ]
    }
  ]
}
